# Handover environment variables.
#
# NOTE: there is no automatic .env loading — copy this file and export the
# variables yourself, or run the CLI with Node's built-in support:
#   node --env-file=.env dist/cli.js ...
# (npm scripts do not pass --env-file automatically.)

# GitHub personal access token (repo scope for private repos; public repos work with any token for higher rate limits)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub Enterprise Server (optional): base API URL, e.g. https://ghe.example.com/api/v3
# GITHUB_API_URL=

# GITHUB_API_URL is where GITHUB_TOKEN is sent, so its host is allow-listed.
# api.github.com is always allowed; list your Enterprise host here or the run
# fails instead of shipping the token somewhere unexpected.
# HANDOVER_GHE_HOST=ghe.example.com

# LLM synthesis is OFF by default — chapters 4-6 are deterministic and nothing
# leaves this machine. Turn it on explicitly with --use-llm or this variable.
# HANDOVER_LLM=1

# Older explicit-off switch (equivalent to --no-llm); the default is already off.
# HANDOVER_NO_LLM=1

# Secret scrubbing is ON by default (the digest and the book quote raw repository
# text). Set this only if you have verified the history carries no secrets.
# HANDOVER_NO_REDACT=1
#
# HANDOVER_REDACT=1 is the legacy explicit-on spelling from 0.1.2 and earlier.
# Redaction is already on, so it now has no effect; it is still accepted.
# HANDOVER_REDACT=1

# LLM provider: openai | anthropic | ollama — only consulted when synthesis is on
HANDOVER_PROVIDER=anthropic

# Model override (per-provider default is used if unset)
# HANDOVER_MODEL=

# Provider credentials — only the one matching HANDOVER_PROVIDER is required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama base URL (fully local, no key needed)
OLLAMA_URL=http://localhost:11434

# Per-request timeouts (milliseconds). Each is one attempt: a hung connection is
# abandoned after this, then retried with backoff. Raise them for a slow GitHub
# Enterprise Server or a small local model; a non-numeric value falls back to the
# default rather than silently disabling the bound.
# HANDOVER_GITHUB_TIMEOUT_MS=60000
# HANDOVER_LLM_TIMEOUT_MS=120000

# Directory for the SQLite index and the generated book (default: ./handover-data)
# HANDOVER_DATA_DIR=

# MCP server only: an extra root the model-supplied dataDir may live inside.
# Without it the server confines the index and the book to its own working
# directory, because a model-driven argument must not write anywhere it likes.
# HANDOVER_DATA_ROOT=

# MCP server only: comma-separated directories the model-supplied gitDirs may
# point at (the launch directory and HANDOVER_DATA_ROOT are always allowed).
# A gitDir outside these roots is refused — reading a git clone is reading
# everything inside it, so a model-driven path must stay where the operator
# chose.
# HANDOVER_GIT_ROOT=D:\clones,E:\work\repos
